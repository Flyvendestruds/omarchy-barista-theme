#!/bin/bash
# Theme-aware: start the gap watcher for barista, stop it otherwise.
# Either way run the sync once so the shell's gap state file picks up the
# new theme name (barista enables gap-following margins; other themes reset
# to stock). omarchy-hook passes the theme name as $1.
# The post-boot hook + bar_gap.lua cover hypr loads; this covers live
# theme switches without reboot.
THEME="${1:-}"
BIN="$HOME/.local/bin/barista-bar-gap-sync"
UNIT="barista-bar-gap-watcher.service"

if [[ "$THEME" == "barista" || "$THEME" == "barista-dark" ]]; then
  systemctl --user enable --now "$UNIT" >/dev/null 2>&1 || true
  "$BIN" >/dev/null 2>&1 &
else
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
  "$BIN" >/dev/null 2>&1 &
fi
