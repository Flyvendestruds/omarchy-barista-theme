#!/bin/bash
# Barista-only: start the gap watcher at boot when barista is the active
# theme, otherwise make sure it's stopped (e.g. user switched away last
# session). Reads the same theme.name file `omarchy theme set` writes.
CURRENT="$HOME/.local/state/omarchy/current/theme.name"
UNIT="barista-bar-gap-watcher.service"
BIN="$HOME/.local/bin/barista-bar-gap-sync"

if [[ -f "$CURRENT" ]] && [[ "$(cat "$CURRENT" 2>/dev/null)" == "barista" ]]; then
  systemctl --user enable --now "$UNIT" >/dev/null 2>&1 || true
  "$BIN" >/dev/null 2>&1 &
else
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
fi
