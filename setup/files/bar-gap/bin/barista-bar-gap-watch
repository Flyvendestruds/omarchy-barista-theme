#!/bin/bash
# Watch for gap-relevant changes and sync:
#  1. shell.json transparency/position writes (inotify on the directory —
#     omarchy-bar rewrites shell.json atomically via tmp + mv, which swaps
#     the inode and silently detaches a file-level watch). Debounced +
#     state-hashed so reminders/widget churn doesn't trigger hyprctl.
#  2. bar-off toggle (bar shown/hidden): inotify on the toggles dir.
#     A hidden bar keeps the solid gap, so hidden counts as solid.
#  3. Hyprland gaps_out edits made outside this script (looknfeel tweaks,
#     `hyprctl` experiments): polled every 3s with a full sync. The sync
#     derives its base from the live non-bar sides, so it adopts the new
#     size while re-applying the bar-side rule — converging in one extra
#     pass (sync is idempotent: same gaps in, same gaps out).

set -u

CONFIG="$HOME/.config/omarchy/shell.json"
DIR="$(dirname "$CONFIG")"
BASE_F="$(basename "$CONFIG")"
TOGGLES_DIR="$HOME/.local/state/omarchy/toggles"
TOGGLE_F="bar-off"
SYNC="$HOME/.local/bin/barista-bar-gap-sync"

mkdir -p "$TOGGLES_DIR" 2>/dev/null || true

bar_state() {
  python3 -c "
import json
try:
    b = json.load(open('$HOME/.config/omarchy/shell.json')).get('bar', {})
    print(b.get('transparent', True), b.get('position', 'top'))
except Exception:
    print('UNKNOWN')
" 2>/dev/null
}

bar_hidden() {
  [[ -f "$TOGGLES_DIR/$TOGGLE_F" ]] && echo yes || echo no
}

hypr_css() {
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl -j getoption general:gaps_out 2>/dev/null
  else
    hyprctl -i 0 -j getoption general:gaps_out 2>/dev/null
  fi | python3 -c "
import json, sys
try:
    print(json.load(sys.stdin).get('css', ''))
except Exception:
    pass
" 2>/dev/null
}

LAST_BAR="$(bar_state)"
LAST_HIDDEN="$(bar_hidden)"
LAST_HYPR="$(hypr_css)"

# inotify streams in the background; hypr poll in the foreground loop.
# The toggles dir watch fires on bar-off create/delete (toggle on/off).
inotifywait -m -e close_write,moved_to,create --format "%e %f" "$DIR" 2>/dev/null | while read -r events file; do
  [[ "$file" == "$BASE_F" ]] || continue
  sleep 0.2
  STATE="$(bar_state)"
  if [[ -n "$STATE" && "$STATE" != "UNKNOWN" && "$STATE" != "$LAST_BAR" ]]; then
    LAST_BAR="$STATE"
    "$SYNC" >/dev/null 2>&1
    LAST_HYPR="$(hypr_css)"
  fi
done &
INOTIFY_PID=$!

inotifywait -m -e create,delete,moved_to,close_write --format "%e %f" "$TOGGLES_DIR" 2>/dev/null | while read -r events file; do
  [[ "$file" == "$TOGGLE_F" ]] || continue
  HIDDEN="$(bar_hidden)"
  if [[ "$HIDDEN" != "$LAST_HIDDEN" ]]; then
    LAST_HIDDEN="$HIDDEN"
    "$SYNC" >/dev/null 2>&1
    LAST_HYPR="$(hypr_css)"
  fi
done &
TOGGLES_PID=$!

trap 'kill "$INOTIFY_PID" "$TOGGLES_PID" 2>/dev/null; exit 0' INT TERM EXIT

while sleep 3; do
  CSS="$(hypr_css)"
  if [[ -n "$CSS" && "$CSS" != "$LAST_HYPR" ]]; then
    LAST_HYPR="$CSS"
    "$SYNC" >/dev/null 2>&1
    LAST_HYPR="$(hypr_css)"
  fi
done
